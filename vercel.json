{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/lead-magnet/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/package.json",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/about-us.html",
      "destination": "/about-us",
      "permanent": true
    },
    {
      "source": "/faq.html",
      "destination": "/faq",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/free-review.html",
      "destination": "/free-review",
      "permanent": true
    }
  ],
  "functions": {
    "api/review.js": {
      "maxDuration": 300,
      "includeFiles": "lead-magnet/{assets,samples}/**"
    }
  }
}
